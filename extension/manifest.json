{
  "manifest_version": 3,
  "name": "GTM Audit — Tag, Privacy & Performance Auditor",
  "version": "1.0.0",
  "description": "Audits any website for tag, privacy, compliance, performance, SEO and security issues. Includes Omnibug-style tag detection and Data Slayer-style dataLayer inspection.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "cookies",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GTM Audit"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
