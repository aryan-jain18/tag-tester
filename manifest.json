{
  "manifest_version": 3,
  "name": "Tag Tester — Consent, Ads, GA4 & Cookie Auditor",
  "version": "0.1.0",
  "description": "Audits live page traffic for consent gating, ad-platform coverage, GA4 config/events, and cookie hygiene. Inspired by Omnibug and Data Slayer.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "cookies",
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "devtools_page": "devtools/devtools.html",
  "action": {
    "default_title": "Tag Tester"
  }
}
